# Copy to `.env` next to docker-compose.tailscale.yml and fill in the values.
# docker compose reads `.env` automatically when run from this directory.

# Image tag to deploy (see Docker Hub: ciberado/minicalen). Use a version like
# 2.1.0 for reproducible deploys, or `latest`.
IMAGE_TAG=latest

# Tailscale auth key for the sidecar.
CLIENT_SECRET=tskey-auth-xxxxxxxxxxxxxxxx

# Extra flags for `tailscale up`. Leave empty to join the node as your own
# device (no ACL tags needed). To use a tag, create a tagged auth key and set:
#   TS_EXTRA_ARGS=--advertise-tags=tag:container
TS_EXTRA_ARGS=

# Better-Auth secret, at least 32 characters. Generate one with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public URL of the deployment and the origin allowed by CORS / Better-Auth.
BETTER_AUTH_URL=https://minicalen.mininube.com
ALLOWED_ORIGINS=https://minicalen.mininube.com

# Host directory where the SQLite database is stored (bind-mounted to /app/data).
DATA_DIR=/home/javi/services/minicalen/data
